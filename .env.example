# geoxis: every env var the code reads. Set them in Vercel (Production), never commit real values.
APIXIS_CLIENT_ID=geoxis
# optional; defaults to <this site>/auth/apixis/callback
APIXIS_REDIRECT_URI=
# optional; older name for WALLET_API_KEY
APIXIS_WALLET_API_KEY=
APIXIS_WALLET_API_URL=https://apixis-wallet.vercel.app
# optional; defaults to https://apixis.dev
APIXIS_WORLD_API=
# this site's Apixis world key; its SHA-256 is listed in APIXIS_WORLD_KEYS on apixis.dev
APIXIS_WORLD_KEY=
APP_URL=
# this site's apx_live_ key from the Wallet (npm run family-keys -- --only <site>)
WALLET_API_KEY=
# Ship24 Tracking API key. Server only. Never expose to the browser.
SHIP24_API_KEY=
# Free OpenSky account for a 90 s worldwide aircraft refresh (anonymous: every 15 min). Optional.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Free aisstream.io key for live ships. Optional; demo vessels without it.
AISSTREAM_API_KEY=
