# Geoxis: environment variables. Copy to .env.local for local dev;
# set the same names in Vercel → Settings → Environment Variables. Never commit real values.

# ── Added 2026-09-25: keys the code reads that were not listed here ──
# Required
# Cixy's AI (console.anthropic.com → API keys). Server only.
ANTHROPIC_API_KEY=
# Transactional email (resend.com). Needed for support/sign-in emails.
RESEND_API_KEY=
# Supabase anon/publishable key.
SUPABASE_ANON_KEY=
# Supabase service_role key. Server only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase project URL (server).
SUPABASE_URL=
# This site's Apixis Wallet key (apx_live_…). From `npm run family-keys` in ApixisWallet. Server only.
WALLET_API_KEY=
# Apixis.dev world-agent + family-feed key for client `geoxis` (api/world/provision.js, api/feed-session.js). Server only.
APIXIS_WORLD_KEY=
# Optional
# Wallet base URL. Default https://apixis-wallet.vercel.app
APIXIS_WALLET_API_URL=
# Public site URL, e.g. https://<site>.vercel.app
APP_URL=
# ── Added 2026-10-06 (Claude): the rest of what the code reads ──
# Apixis.dev base URL. Default https://www.apixis.dev
APIXIS_WORLD_API=
# SSO client id registered with the Wallet. Default geoxis
APIXIS_CLIENT_ID=
# SSO callback override. Default <APP_URL>/auth/apixis/callback
APIXIS_REDIRECT_URI=
# Cixy model id (lib/core.js cixyModel). Default claude-sonnet-5
AI_MODEL=
# Extra owner/admin emails, comma-separated (lib/core.js). Both owner emails are always included.
ADMIN_EMAILS=
# Legacy names (leave unset)
# Legacy name for WALLET_API_KEY. Leave unset.
# APIXIS_WALLET_API_KEY=
# Ship24 Tracking API key (server only). Free tier is 10 shipments/month. See NOTES/GROK.md 2026-10-06.
SHIP24_API_KEY=
# ── Added 2026-10-17 (Claude, redesign): live feeds for the globe ──
# Free OpenSky account (opensky-network.org → account → API client). Without these the worldwide
# aircraft feed still works, refreshed every 15 minutes (anonymous quota). With them: every 90 s.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Optional override of the aircraft refresh window in ms (min 10000).
AIR_REFRESH_MS=
# Free aisstream.io key. Without it ships are the Rotterdam demo vessels.
AISSTREAM_API_KEY=
